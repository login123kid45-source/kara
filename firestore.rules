rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives & Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMode(mode) {
      return mode is string && mode.size() >= 4 && mode.size() <= 16 &&
        (mode == 'regular' || mode == 'bratty' || mode == 'uncensored' || mode == 'romantic' || mode == 'parent');
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredMode', 'autoAdaptMode', 'soapWashCount', 'bondLevel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'preferredMode', 'autoAdaptMode', 'soapWashCount', 'bondLevel', 'createdAt', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isValidMode(data.preferredMode) &&
        data.autoAdaptMode is bool &&
        data.soapWashCount is int && data.soapWashCount >= 0 && data.soapWashCount <= 100000 &&
        data.bondLevel is int && data.bondLevel >= 0 && data.bondLevel <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMemoryItem(data) {
      return data.keys().hasAll(['id', 'userId', 'category', 'content', 'importance', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'category', 'content', 'importance', 'createdAt']) &&
        isValidId(data.id) &&
        data.userId == request.auth.uid &&
        isValidId(data.userId) &&
        data.category is string && data.category.size() >= 4 && data.category.size() <= 16 &&
        (data.category == 'preference' || data.category == 'fact' || data.category == 'emotion' || data.category == 'bond' || data.category == 'date' || data.category == 'milestone') &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 500 &&
        data.importance is int && data.importance >= 1 && data.importance <= 5 &&
        data.createdAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'mode', 'emotionDetected', 'soapTriggered', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'role', 'content', 'mode', 'emotionDetected', 'soapTriggered', 'createdAt']) &&
        isValidId(data.id) &&
        data.userId == request.auth.uid &&
        isValidId(data.userId) &&
        data.role is string && data.role.size() >= 4 && data.role.size() <= 12 &&
        (data.role == 'user' || data.role == 'assistant') &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 8000 &&
        isValidMode(data.mode) &&
        data.emotionDetected is string && data.emotionDetected.size() >= 1 && data.emotionDetected.size() <= 40 &&
        data.soapTriggered is bool &&
        data.createdAt is timestamp;
    }

    function isValidSoapIncident(data) {
      return data.keys().hasAll(['id', 'userId', 'offendingWord', 'scoldingMessage', 'resolved', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'offendingWord', 'scoldingMessage', 'resolved', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.userId == request.auth.uid &&
        isValidId(data.userId) &&
        data.offendingWord is string && data.offendingWord.size() >= 1 && data.offendingWord.size() <= 64 &&
        data.scoldingMessage is string && data.scoldingMessage.size() >= 1 && data.scoldingMessage.size() <= 600 &&
        data.resolved is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Connection test path (read-only check for offline detection)
    match /test/connection {
      allow get: if isSignedIn();
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidUserProfile(incoming()) &&
        isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Update Preferences / Mode / Bond / Soap Counter
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredMode', 'autoAdaptMode', 'soapWashCount', 'bondLevel', 'updatedAt'])
        );
      allow delete: if false;

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(memoryId) &&
          isValidMemoryItem(incoming()) &&
          incoming().id == memoryId &&
          incoming().userId == userId &&
          incoming().createdAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidMemoryItem(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(memoryId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == request.time &&
          (
            // Action: Update Memory Item
            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'content', 'importance', 'createdAt'])
          );
        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(memoryId);
      }

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().userId == userId &&
          incoming().createdAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidChatMessage(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(messageId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().role == existing().role &&
          incoming().createdAt == request.time &&
          (
            // Action: Edit or Retry Chat Message
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'mode', 'emotionDetected', 'soapTriggered', 'createdAt'])
          );
        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(messageId);
      }

      match /soapIncidents/{incidentId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(incidentId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(incidentId) &&
          isValidSoapIncident(incoming()) &&
          incoming().id == incidentId &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidSoapIncident(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(incidentId) &&
          existing().resolved == false &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().offendingWord == existing().offendingWord &&
          incoming().scoldingMessage == existing().scoldingMessage &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action: Resolve Soap Scrubbing
            incoming().resolved == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'updatedAt'])
          );
        allow delete: if false;
      }
    }
  }
}
