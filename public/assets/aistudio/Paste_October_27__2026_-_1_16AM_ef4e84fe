    let isUnhinged = true;

    if (unhingedToggle && unhingedThumb) {
      unhingedToggle.addEventListener('click', () => {
        isUnhinged = !isUnhinged;
        if (isUnhinged) {
          unhingedThumb.classList.remove('left-0.5');
          unhingedThumb.classList.add('left-4');
          unhingedToggle.classList.remove('bg-surface-container-highest');
          unhingedToggle.classList.add('bg-secondary-container');
        } else {
          unhingedThumb.classList.remove('left-4');
          unhingedThumb.classList.add('left-0.5');
          unhingedToggle.classList.remove('bg-secondary-container');
          unhingedToggle.classList.add('bg-surface-container-highest');
        }
      });
    }

    const terminalBody = document.getElementById('terminalBody');
    const terminalInput = document.getElementById('terminalInput');
    const sendCmdBtn = document.getElementById('sendCmdBtn');
    const clearStreamBtn = document.getElementById('clearStreamBtn');
    const liveStreamCursor = document.getElementById('liveStreamCursor');

    function appendTerminalLog(msg, colorClass = 'text-secondary') {
      if (!terminalBody || !liveStreamCursor) return;
      const logLine = document.createElement('div');
      logLine.className = `${colorClass}`;
      const now = new Date();
      const timeStr = `[${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}.${String(now.getMilliseconds()).padStart(3, '0')}]`;
      logLine.textContent = `${timeStr} ${msg}`;
      terminalBody.insertBefore(logLine, liveStreamCursor);
      terminalBody.scrollTop = terminalBody.scrollHeight;
    }

    function handleCommand() {
      if (!terminalInput) return;
      const val = terminalInput.value.trim();
      if (!val) return;
      appendTerminalLog(`EXEC: ${val}`, 'text-on-surface');
      terminalInput.value = '';

      setTimeout(() => {
        appendTerminalLog(`ACK: Autonomous agent swarm accepted command '${val}' and dispatched to 3 sub-agents.`, 'text-secondary');
      }, 450);
    }

    if (sendCmdBtn && terminalInput) {
      sendCmdBtn.addEventListener('click', handleCommand);
      terminalInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleCommand();
      });
    }

    if (clearStreamBtn && terminalBody && liveStreamCursor) {
      clearStreamBtn.addEventListener('click', () => {
        terminalBody.innerHTML = '';
        terminalBody.appendChild(liveStreamCursor);
        appendTerminalLog('STREAM: Buffer cleared. Realtime telemetry active.', 'text-outline font-label-telemetry');
      });
    }

    const killswitchBtn = document.getElementById('killswitchBtn');
    if (killswitchBtn) {
      killswitchBtn.addEventListener('click', () => {
        const confirmed = confirm('DANGER: Trigger global emergency killswitch for all 14 active Grokbots and freeze ongoing mempool/fuzzing loops?');
        if (confirmed) {
          appendTerminalLog('ALERT: EMERGENCY KILLSWITCH TRIGGERED. Suspending all 14 autonomous runtimes...', 'text-error font-bold');
        }
      });
    }

    const actionButtons = document.querySelectorAll('.queue-item button');
    actionButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const parentCard = this.closest('.queue-item');
        if (this.textContent.includes('Authorize') || this.textContent.includes('Release') || this.textContent.includes('Sign')) {
          this.disabled = true;
          this.textContent = 'Executed';
          if (parentCard) {
            parentCard.style.opacity = '0.5';
          }
        }
      });
    });
  })();
</script></main></div></body></html>